---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects — Arian Lopez" description="Open source projects by Arian Lopez.">
  <section class="projects-page">
    <h1>Projects</h1>
    <p class="projects-intro">Things I've built.</p>

    <div class="project-card">
      <div class="project-header">
        <span class="project-name">Trabuco</span>
        <span class="project-tag">Open Source</span>
      </div>
      <p class="project-description">
        A production-ready CLI for generating Java multi-module Maven projects, built around deep coding-agent integration &mdash; including the ability to scaffold AI agents themselves.
      </p>
      <div class="project-details">
        <h3>Key features</h3>
        <ul>
          <li><strong>Production-ready by default</strong> &mdash; One command produces a fully wired Spring Boot codebase with clean module boundaries, Spring Data JDBC, Flyway, Testcontainers, Resilience4j, ArchUnit boundary tests, Prometheus, and OpenAPI. No templates to download, no manual setup.</li>
          <li><strong>Built for AI agents &mdash; and to build AI agents</strong> &mdash; Generated projects ship task prompts and per-agent rule files so Claude Code, Codex, Cursor, and Copilot can extend them natively. Trabuco itself is a Claude Code plugin and MCP server. And the AIAgent module scaffolds a runnable Spring AI agent with tools, guardrails, multi-agent orchestration, MCP, and A2A &mdash; wired and testable from the first commit.</li>
        </ul>
      </div>
      <div class="project-tech">
        <span class="tech-tag">Go</span>
        <span class="tech-tag">Java</span>
        <span class="tech-tag">Maven</span>
        <span class="tech-tag">Spring Boot</span>
        <span class="tech-tag">Spring AI</span>
        <span class="tech-tag">MCP</span>
      </div>
      <div class="project-links">
        <a href="https://github.com/arianlopezc/Trabuco" target="_blank" rel="noopener">View on GitHub &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-page {
    padding: 1rem 0 2rem;
  }

  .projects-intro {
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  .project-details {
    margin-bottom: 1.2rem;
  }

  .project-details h3 {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-details ul {
    padding-left: 1.2rem;
    font-size: 0.95rem;
  }

  .project-details li {
    margin-bottom: 0.6rem;
    line-height: 1.6;
  }

  .project-links {
    margin-top: 1rem;
  }

  .project-links a {
    font-size: 0.9rem;
    font-weight: 500;
  }
</style>
